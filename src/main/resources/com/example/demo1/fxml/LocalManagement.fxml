<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="900" prefWidth="1400" styleClass="root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo1.marketfruits.LocalManagementController">

    <!-- Top Navigation Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-nav" stylesheets="@../css/dashboard.css">
            <padding>
                <Insets bottom="12" left="20" right="20" top="12" />
            </padding>

            <Label styleClass="app-title" text="🌾 কৃষি সাথী" />
            <Label styleClass="bd-badge" text="BD" />

            <Region HBox.hgrow="ALWAYS" />

            <Button styleClass="sound-btn">
                <graphic>
                    <Label text="🔇" />
                </graphic>
            </Button>

            <Label styleClass="online-status" text="📶 অনলাইনে" />
        </HBox>
    </top>

    <!-- Left Sidebar -->
    <left>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sidebar-scroll" vbarPolicy="AS_NEEDED">
            <VBox spacing="5" styleClass="sidebar" stylesheets="@../css/dashboard.css">
                <padding>
                    <Insets bottom="20" left="10" right="10" top="20" />
                </padding>

                <Button text="🏠 হোম" styleClass="sidebar-btn, active-btn" fx:id="btnHome"/>
                <Button text="📅 পরিকল্পনা ও হিসাব" styleClass="sidebar-btn" fx:id="btnAdvisory"/>
                <Button fx:id="btnStorage" styleClass="sidebar-btn" text="🏪 গুদাম ও সংরক্ষণ" />
                <Button text="👷শ্রমিক ব্যবস্থাপনা" styleClass="sidebar-btn" fx:id="btnLocalManagement"/>
                <Button fx:id="btnMachinery" styleClass="sidebar-btn" text="🚜 যন্ত্রপাতি" />
                <Button text="🚜 খামার ব্যবস্থাপনা" styleClass="sidebar-btn" fx:id="btnFarmManagement"/>

                <Button text="🩺 স্মার্ট ডায়াগনস্টিক" styleClass="sidebar-btn" fx:id="btnSmartDiagnostic"/>

                <Button text="🛒 ডিজিটাল হাট" styleClass="sidebar-btn" fx:id="btnDigitalHat"/>

                <Button text="🛡️ শস্য বীমা" styleClass="sidebar-btn" fx:id="btnCropInsurance"/>

                <Button text="📈 বাজার দর ও বিশ্লেষণ" styleClass="sidebar-btn" fx:id="btnMarketFinance"/>
                <Button fx:id="btnGovtSchemes" text="🏛️ সরকারি সুবিধা ও ভর্তুকি" styleClass="sidebar-btn" />

                <Button text="💬 বিশেষজ্ঞ চ্যাট" styleClass="sidebar-btn" fx:id="btnExpertChat"/>

                <Button text="📚 কৃষি পাঠশালা" styleClass="sidebar-btn" fx:id="btnLearningHub"/>
                <Button text="📞 সরকারি সেবা ও সাহায্য" styleClass="sidebar-btn" fx:id="btnEmergencyHelp"/>
                <Button fx:id="btnProfile" styleClass="sidebar-btn" text="👤 প্রোফাইল" />
            </VBox>
        </ScrollPane>
    </left>

    <!-- Main Content Area -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" styleClass="content-scroll" vbarPolicy="ALWAYS">
            <VBox spacing="25" styleClass="main-content" stylesheets="@../css/LocalManagement.css">
                <padding>
                    <Insets bottom="30" left="30" right="30" top="30" />
                </padding>

                <!-- Page Header -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label styleClass="page-title-large" text="👥 শ্রমিক ব্যবস্থাপনা" />
                        </HBox>
                        <Label styleClass="page-subtitle" text="কৃষি শ্রমিকদের কাজ ও পেমেন্ট ট্র্যাক করুন" />
                    </VBox>

                    <Button fx:id="addRecordBtn" styleClass="add-record-btn" text="+ নতুন রেকর্ড" />
                </HBox>

                <!-- Statistics Cards -->
                <HBox alignment="CENTER" spacing="20">

                    <!-- Total Workers Card -->
                    <VBox spacing="10" styleClass="stat-card-blue" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets bottom="25" left="25" right="25" top="25" />
                        </padding>
                        <Label styleClass="stat-card-label" text="মোট শ্রমিক" />
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label fx:id="totalWorkersLabel" styleClass="stat-card-value-large" text="0" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="stat-card-icon" text="👥" />
                        </HBox>
                    </VBox>

                    <!-- Pending Payment Card -->
                    <VBox spacing="10" styleClass="stat-card-orange" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets bottom="25" left="25" right="25" top="25" />
                        </padding>
                        <Label styleClass="stat-card-label" text="বাকি পেমেন্ট" />
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label fx:id="pendingPaymentLabel" styleClass="stat-card-value-large" text="৳0" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="stat-card-icon" text="🕐" />
                        </HBox>
                    </VBox>

                    <!-- Completed Payment Card -->
                    <VBox spacing="10" styleClass="stat-card-green" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets bottom="25" left="25" right="25" top="25" />
                        </padding>
                        <Label styleClass="stat-card-label" text="সম্পন্ন পেমেন্ট" />
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label fx:id="completedPaymentLabel" styleClass="stat-card-value-large" text="৳0" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="stat-card-icon" text="✓" />
                        </HBox>
                    </VBox>

                </HBox>

                <!-- Workers Records Section -->
                <VBox spacing="20" styleClass="records-section">
                    <padding>
                        <Insets bottom="25" left="25" right="25" top="25" />
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label styleClass="section-heading-large" text="শ্রমিক রেকর্ড" />
                        <Region HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="filterComboBox" prefWidth="150" promptText="ফিল্টার করুন" styleClass="filter-combo" />
                    </HBox>

                    <!-- Workers List -->
                    <VBox fx:id="workersListContainer" spacing="15">
                        <!-- Empty state will be shown initially -->
                        <VBox fx:id="emptyState" alignment="CENTER" minHeight="300" spacing="20" styleClass="empty-state">
                            <Label styleClass="empty-icon" text="👷" />
                            <Label styleClass="empty-text" text="এখনও কোন শ্রমিক রেকর্ড নেই" />
                            <Label styleClass="empty-subtext" text="উপরের '+ নতুন রেকর্ড' বাটনে ক্লিক করে শুরু করুন" />
                        </VBox>

                        <!-- Worker records will be dynamically added here -->
                    </VBox>
                </VBox>

                <!-- Quick Tips Section -->
                <VBox spacing="15" styleClass="tips-card-info">
                    <padding>
                        <Insets bottom="20" left="25" right="25" top="20" />
                    </padding>

                    <Label styleClass="tips-heading" text="💡 শ্রমিক ব্যবস্থাপনার টিপস" />

                    <VBox spacing="10">
                        <Label styleClass="tip-item-info" text="• প্রতিদিনের কাজ শেষে রেকর্ড আপডেট করুন" />
                        <Label styleClass="tip-item-info" text="• নিয়মিত পেমেন্ট করলে শ্রমিকরা খুশি থাকে" />
                        <Label styleClass="tip-item-info" text="• শ্রমিকদের নাম, মোবাইল নম্বর সংরক্ষণ করুন" />
                        <Label styleClass="tip-item-info" text="• মৌসুমি কাজের জন্য আগে থেকে পরিকল্পনা করুন" />
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
