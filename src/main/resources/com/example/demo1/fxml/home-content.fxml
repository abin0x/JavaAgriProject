<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="main-scroll-pane" stylesheets="@../css/Home.css" vbarPolicy="AS_NEEDED" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <VBox spacing="30" styleClass="root-container">
        <padding>
            <Insets bottom="35" left="35" right="35" top="25" />
        </padding>

        <!-- ১. হিরো ব্যানার: প্রিমিয়াম গ্রেডিয়েন্ট ও এলার্ট -->
        <AnchorPane styleClass="hero-banner">
            <VBox spacing="10" AnchorPane.leftAnchor="30" AnchorPane.topAnchor="30">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="স্বাগতম, জনাব শৌমিক" styleClass="hero-welcome"/>
                    <Label text="PREMIUM" styleClass="premium-badge"/>
                </HBox>
                <Label text="রবিবার, ২৩ নভেম্বর ২০২৫ | শুভ সকাল!" styleClass="hero-date"/>
                <HBox styleClass="alert-pill-container">
                    <Label text="⚠️ ভারী বৃষ্টির সতর্কতা: নিচু জমি থেকে পানি নিষ্কাশন করুন।" styleClass="alert-pill-text"/>
                </HBox>
            </VBox>

            <!-- ওয়েদার গ্লাস বক্স -->
            <VBox spacing="5" AnchorPane.rightAnchor="30" AnchorPane.topAnchor="25" alignment="CENTER" styleClass="weather-glass-box">
                <HBox spacing="15" alignment="CENTER">
                    <Label text="২৮°C" styleClass="hero-temp"/>
                    <Label text="☀️" styleClass="hero-weather-icon"/>
                </HBox>
                <Label text="আংশিক মেঘলা" styleClass="hero-weather-desc"/>
            </VBox>
        </AnchorPane>

        <!-- ২. ৪টি স্মার্ট স্ট্যাটাস কার্ড -->
        <GridPane hgap="25">
            <columnConstraints>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
            </columnConstraints>

            <VBox styleClass="stat-card br-green" GridPane.columnIndex="0">
                <Label text="🌱 চলমান ফসল" styleClass="stat-label"/>
                <Label text="০৩টি" styleClass="stat-value-main"/>
                <Label text="↗ +১ গত সপ্তাহ থেকে" styleClass="stat-trend-up"/>
            </VBox>

            <VBox styleClass="stat-card br-blue" GridPane.columnIndex="1">
                <Label text="💧 মাটির আর্দ্রতা" styleClass="stat-label"/>
                <Label text="৬৫%" styleClass="stat-value-main"/>
                <ProgressBar progress="0.65" maxWidth="Infinity" styleClass="moisture-bar"/>
            </VBox>

            <VBox styleClass="stat-card br-orange" GridPane.columnIndex="2">
                <Label text="💰 আজকের আয়" styleClass="stat-label"/>
                <Label text="৳ ১,২০০" styleClass="stat-value-main"/>
                <Label text="লাইভ বাজার দর অনুযায়ী" styleClass="stat-subtext"/>
            </VBox>

            <VBox styleClass="stat-card br-purple" GridPane.columnIndex="3">
                <Label text="🏛️ নতুন ভর্তুকি" styleClass="stat-label"/>
                <Label text="০২টি" styleClass="stat-value-main"/>
                <Button text="আবেদন করুন" styleClass="btn-mini-apply"/>
            </VBox>
        </GridPane>

        <!-- ৩. কার্যক্রম ও বাজার দর (Two Column Layout) -->
        <HBox spacing="30">
            <VBox styleClass="main-card" HBox.hgrow="ALWAYS" prefWidth="600">
                <HBox alignment="CENTER_LEFT">
                    <Label text="📅 শস্য ক্যালেন্ডার" styleClass="card-header-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="সব দেখুন →" styleClass="btn-view-all"/>
                </HBox>
                <Separator styleClass="custom-sep"/>
                <VBox spacing="15">
                    <HBox styleClass="task-row-active" spacing="20" alignment="CENTER_LEFT">
                        <VBox alignment="CENTER" styleClass="calendar-chip">
                            <Label text="২৩" styleClass="chip-day"/>
                            <Label text="নভে" styleClass="chip-month"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="বোরো ধান: ইউরিয়া সার প্রয়োগ" styleClass="task-main-text"/>
                            <Label text="জমিতে ৫-৭ সেমি পানি রাখা আবশ্যক" styleClass="task-sub-text"/>
                        </VBox>
                        <CheckBox selected="true" styleClass="task-check"/>
                    </HBox>
                </VBox>
            </VBox>

            <VBox styleClass="main-card" HBox.hgrow="ALWAYS" prefWidth="400">
                <HBox alignment="CENTER_LEFT">
                    <Label text="📊 লাইভ বাজার দর" styleClass="card-header-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="কারওয়ান বাজার" styleClass="market-location-tag"/>
                </HBox>
                <Separator styleClass="custom-sep"/>
                <VBox spacing="12">
                    <HBox styleClass="market-list-item">
                        <Label text="ধান (বিআর-২৮)" styleClass="m-item-name" HBox.hgrow="ALWAYS"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="৳১,২০০" styleClass="m-item-price"/>
                        <Label text="▲" styleClass="m-trend-up"/>
                    </HBox>
                    <HBox styleClass="market-list-item">
                        <Label text="পেঁয়াজ (দেশি)" styleClass="m-item-name" HBox.hgrow="ALWAYS"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="৳৮৫" styleClass="m-item-price"/>
                        <Label text="▼" styleClass="m-trend-down"/>
                    </HBox>
                </VBox>
                <Button text="বিস্তারিত বিশ্লেষণ দেখুন" maxWidth="Infinity" styleClass="btn-market-analysis"/>
            </VBox>
        </HBox>

        <!-- ৪. স্মার্ট একশন বাটন (Quick Actions) -->
        <HBox spacing="20" alignment="CENTER">
            <Button text="🔍 পোকা শনাক্ত" styleClass="smart-action-btn action-pest"/>
            <Button text="🛒 হাট বাজার" styleClass="smart-action-btn action-market"/>
            <Button text="🏛️ সরকারি সুবিধা" styleClass="smart-action-btn action-gov"/>
            <Button text="💬 বিশেষজ্ঞ চ্যাট" styleClass="smart-action-btn action-expert"/>
        </HBox>
    </VBox>
</ScrollPane>