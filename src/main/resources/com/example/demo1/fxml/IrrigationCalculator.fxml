                                    <!--                                            </HBox>-->
                                    <!--                                            <HBox alignment="CENTER_LEFT" spacing="10">-->
                                    <!--                                                <Label styleClass="cost-item-label" text="শ্রমিক খরচ:" />-->
                                    <!--                                                <Region HBox.hgrow="ALWAYS" />-->
                                    <!--                                                <Label fx:id="laborCostLabel" styleClass="cost-item-value" text="৳ 0.00" />-->
                                    <!--                                            </HBox>-->
                                    <!--                                            <HBox alignment="CENTER_LEFT" spacing="10">-->
                                    <!--                                                <Label styleClass="cost-item-label" text="রক্ষণাবেক্ষণ:" />-->
                                    <!--                                                <Region HBox.hgrow="ALWAYS" />-->
                                    <!--                                                <Label fx:id="maintenanceCostLabel" styleClass="cost-item-value" text="৳ 0.00" />-->
                                    <!--                                            </HBox>-->
                                    <!--                                            <Separator />-->
                                    <!--                                            <HBox alignment="CENTER_LEFT" spacing="10">-->
                                    <!--                                                <Label styleClass="total-irrigation-cost-label" text="মোট খরচ:" />-->
                                    <!--                                                <Region HBox.hgrow="ALWAYS" />-->
                                    <!--                                                <Label fx:id="totalCostLabel" styleClass="total-irrigation-cost-value" text="৳ 0.00" />-->
                                    <!--                                            </HBox>-->
                                    <!--                                        </VBox>-->
                                    <!--                                        <Label styleClass="cost-note" text="প্রতি একর হিসাবে" />-->
                                    <!--                                    </VBox>-->

                                    <!-- Water Saving Tips -->
                                    <VBox spacing="12" styleClass="tips-card-blue">
                                        <Label styleClass="tips-title-blue" text="💡 পানি সাশ্রয়ের টিপস" />
                                        <VBox spacing="8">
                                            <Label styleClass="tip-item-blue" text="• সকাল ৬-৮টা অথবা বিকাল ৪-৬টায় সেচ দিন" />
